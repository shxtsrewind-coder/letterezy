# Copy this file to .env.local and fill in the Supabase project's values
# (Project Settings → API). Same project as the other bgameworld games. The
# anon key is safe to expose client-side — writes are locked down by Row
# Level Security + the submit_letterezy_score RPC.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
